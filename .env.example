# PostgreSQL connection used by every automation/ script.
# Copy to .env and fill in your values. schema.sql creates the tables.
DB_USER=
DB_PASS=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=djinni_market

# Optional Telegram heartbeat after each run (leave empty to disable alerts;
# the scripts log to stdout instead of sending anything).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
